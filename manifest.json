{
  "manifest_version": 3,
  "name": "Yandex → GPX · Speedometer",
  "version": "1.2.1",
  "description": "Export Yandex Maps routes to GPX for Speedometer GPS.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export route to GPX",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
